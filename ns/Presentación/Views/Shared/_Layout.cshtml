@{
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Mi-Ecommerce</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    </head>
    <body>

    <div class="container-fluid">
        <div class="row">
            <!--Sidebar-->
            <div class="col-auto col-sm-3 col-xl-2 bg-dark vh-100 d-flex flex-column justify-content-between p-3 sticky-top">
            
                <div>
                    <!--Encabezado-->
                    <div class="d-flex align-items-center pb-3 mb-3 text-white text-decoration-none border-bottom">
                        <i class="bi bi-house-fill fs-4 me-2"></i>
                        <span class="fs-5 d-none d-sm-inline fw-semibold">E-commerce</span>
                    </div>
                    
                    <!--Lista de Navegación-->
                    <ul class="nav nav-pills flex-column mb-auto">
                        <li class="nav-item mb-1">
                            <a class="btn btn-dark nav-link text-white d-flex justify-content-between align-items-center w-100 text-start" aria-current="page">
                                <div>
                                    <i class="bi bi-speedometer2 me-2"></i>
                                    <span class="d-none d-sm-inline">Dashboard</span>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a href="/Maestro"
                                class="btn btn-dark nav-link text-white d-flex justify-content-between align-items-center w-100 text-start">
                                <div>
                                    <i class="bi bi-book-half me-2"></i>
                                    <span class="d-none d-sm-inline">Maestros</span>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a  href="/Inventario"
                                class="btn btn-dark nav-link text-white d-flex justify-content-between align-items-center w-100 text-start">
                                <div>
                                    <i class="bi bi-boxes me-2"></i>
                                    <span class="d-none d-sm-inline">Inventario</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="btn btn-dark nav-link text-white d-flex justify-content-between align-items-center w-100 text-start">
                                <div>
                                    <i class="bi bi-cash-coin me-2"></i>
                                    <span class="d-none d-sm-inline">Pagos</span>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="btn btn-dark nav-link text-white d-flex justify-content-between align-items-center w-100 text-start">
                                <div>
                                    <i class="bi bi-box-seam-fill me-2"></i>
                                    <span class="d-none d-sm-inline">Pedidos</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>
                <!--Menú dropdown de ajustes e inicio de sesión en la parte inferior-->
                <div class="dropdown border-top pt-3">
                    <a href="#" class="btn btn-dark dropdown-toggle nav-link text-white p-2 rounded hover-effect" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-2 fs-5"></i>
                        <span class="d-none d-sm-inline">Administrador</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class ="bi bi-gear-fill me-2 fs-5"></i>
                                <span class="d-none d-sm-inline">Ajustes</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-arrow-bar-right me-2 fs-5"></i>
                                <span class="d-none d-sm-inline">Cerrar Sesión</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!--Contenido Principal-->
            <div class="col p-0 m-0 vh-100 d-flex flex-column bg-white overflow-hidden">
    
                <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
                    <div class="container-fluid">
                        <span class="navbar-text ms-auto px-3 fw-bold text-secondary">
                            Panel de Administración
                        </span>
                    </div>
                </nav>

                <div class="d-flex flex-grow-1 overflow-hidden">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
            

    </body>
</html>