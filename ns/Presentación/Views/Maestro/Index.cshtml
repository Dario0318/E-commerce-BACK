<script>
    // Arreglo global para almacenar los archivos reales
    let archivosCargados = [];

    document.getElementById('formFile').addEventListener('change', function (event) {
        const files = event.target.files;
        if (!files) return;

        // Convertimos a array y añadimos los nuevos archivos al arreglo global
        Array.from(files).forEach(file => {
            if (file.type.startsWith('image/')) {
                archivosCargados.push(file);
            }
        });

        // Renderizar la vista previa actualizada
        actualizarPrevisualizacion();

        // Limpiamos el input file para que el usuario pueda volver a seleccionar las mismas fotos si quiere
        this.value = '';
    });

    function actualizarPrevisualizacion() {
        const container = document.getElementById('previewContainer');
        container.innerHTML = ''; // Limpiar contenedor

        archivosCargados.forEach((file, index) => {
            const reader = new FileReader();

            reader.onload = function (e) {
                // Crear el contenedor de la tarjeta pequeña (Columna de Bootstrap)
                const col = document.createElement('div');
                col.classList.add('col-4', 'col-md-2', 'position-relative');

                // Crear la imagen
                const img = document.createElement('img');
                img.src = e.target.result;
                img.classList.add('img-thumbnail', 'w-80');
                img.style.height = '80px';
                img.style.objectFit = 'cover';

                // Crear el botón de eliminar (Badge rojo flotante de Bootstrap)
                const btnEliminar = document.createElement('button');
                btnEliminar.type = 'button';
                btnEliminar.innerHTML = '&times;'; // El símbolo X
                btnEliminar.classList.add('btn', 'btn-danger', 'btn-sm', 'position-absolute', 'top-0', 'end-0', 'rounded-circle');
                btnEliminar.style.transform = 'translate(25%, -25%)';
                btnEliminar.style.padding = '0px 6px';

                // Evento para eliminar la imagen específica
                btnEliminar.onclick = function () {
                    archivosCargados.splice(index, 1); // Remover del arreglo
                    actualizarPrevisualizacion(); // Re-renderizar
                };

                // Unir elementos
                col.appendChild(img);
                col.appendChild(btnEliminar);
                container.appendChild(col);
            }

            reader.readAsDataURL(file);
        });
    }

    // INTERCEPTAR EL ENVÍO DEL FORMULARIO
    document.getElementById('productForm').addEventListener('submit', function (event) {
        event.preventDefault(); // Detener el envío tradicional

        // Creamos un FormData vacío
        const formData = new FormData(this);

        // Adjuntamos manualmente los archivos de nuestro arreglo global al FormData
        // El nombre 'ArchivosImagenes' debe coincidir con el parámetro de tu controlador ASP.NET
        archivosCargados.forEach(file => {
            formData.append('ArchivosImagenes', file);
        });

        // Enviar los datos mediante Fetch (AJAX) a tu Backend
        fetch(this.action || window.location.href, {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (response.ok) {
                alert('¡Producto guardado con éxito!');
                window.location.reload(); // O redirigir
            } else {
                alert('Hubo un error al guardar.');
            }
        })
        .catch(error => console.error('Error:', error));
    });
</script>