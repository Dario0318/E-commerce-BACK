                                        <input type="text" class="form-control" id="inputTemporada" placeholder="Ej. Lenovo">
                                    </div>
                                    <div class="mb-3">
                                        <input type="text" class="form-control" id="inputMarca" placeholder="Ingresar precio">
                                        <label for="floatingInput">Precio</label>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <p class="mb-0">Seleccionar subcategoría: </p>
                                        <select class="d-flex form-select align-items-center gap-2" aria-label="Default select example">
                                            <option selected>SubCategorias</option>
                                            <option value="1">One</option>
                                            <option value="2">Two</option>
                                            <option value="3">Three</option>
